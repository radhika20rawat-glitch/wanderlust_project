<nav class="wl-navbar">
  <!-- Brand -->
  <a href="/listings" class="wl-brand">
    <span class="brand-icon">✦</span>
    <span>Wanderlust</span>
  </a>

  <!-- Mobile Menu Toggle -->
  <input type="checkbox" id="wl-menu-toggle">
  <label for="wl-menu-toggle" class="wl-menu-btn">☰</label>

  <!-- Navigation Categories -->
  <div id="filters">
    <div class="filter">
      <a class="nav-link" href="/listings"> 
        <i class="fa-solid fa-globe"></i>
        <p>All</p>
      </a> 
    </div>
    <div class="filter">
      <a class="nav-link" href="/listings"> 
        <i class="fa-regular fa-house"></i>
        <p>Homes</p>
      </a> 
    </div>
    <div class="filter">
      <a class="nav-link" href="/listings"> 
        <i class="fa-solid fa-atom"></i>
        <p>Experieces</p>
      </a>
    </div>  
    <div class="filter">
      <a class="nav-link" href="/listings"> 
        <i class="fa-solid fa-bell-concierge"></i>
        <p>Services</p>
      </a> 
    </div>   
  </div>

  <!-- Right Navigation -->
  <div class="wl-user-nav">
    <a href="/listings/new" class="host-link">Become a host</a>

    <% if (!currUser) { %>
      <a class="signup-btn" href="/signup">
        <i class="fa-regular fa-circle-user"></i>
        <b>Sign up</b>
      </a>
      <a class="login-btn" href="/login">
        <i class="fa-solid fa-right-to-bracket"></i>
        <b>Log in</b>
      </a>
      
    <% } else { %>
      <span class="user-greeting">
        Hi, <%= currUser.username %>
      </span>
      <a class="nav-link" href="/logout">
        <i class="fa-solid fa-arrow-right-from-bracket"></i>
        <b>Log out</b>
      </a>  
    <% } %> 
  </div>
</nav>

<!-- Wanderlust Search Bar -->

<div class="wl-search-container">
  <form action="/listings" method="GET" class="wl-search-bar">

    <div class="search-item">
      <label>Where</label>
      <input type="text" name="location"
        placeholder="Search destinations">
    </div>

    <div class="divider"></div>

    <div class="search-item">
      <label>When</label>
      <input type="date" name="checkin">
    </div>

    <div class="divider"></div>

    <div class="search-item">
      <label>Who</label>
      <select name="guests">
        <option value="">Add guests</option>
        <% for(let i = 1; i <= 10; i++) { %>
          <option value="<%= i %>"><%= i %> guests</option>
        <% } %>
      </select>
    </div>

    <button type="submit" class="search-btn">
      <i class="fa-solid fa-magnifying-glass"></i>
    </button>

  </form>
</div>

</form>
</div>

